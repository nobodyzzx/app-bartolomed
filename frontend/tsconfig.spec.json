/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ]
  },
  // Los componentes con `standalone: false` toman el scope de su template del
  // NgModule que los declara. Si la compilación de tests solo incluyera los
  // specs, esos módulos quedarían fuera del programa y cada elemento de
  // Material daría NG8001/NG8002.
  "include": [
    "src/**/*.ts"
  ]
}
