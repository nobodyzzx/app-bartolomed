{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-types": "npx openapi-typescript src/generated/api-spec.json -o src/generated/api-types.ts && echo 'Tipos generados OK'",
    "generate-types:fetch": "curl -sf http://localhost:3000/api/docs-json -o src/generated/api-spec.json && npm run generate-types",
    "icons:subset": "node scripts/build-icon-subset.mjs",
    "icons:check": "node scripts/build-icon-subset.mjs --check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.9",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.9",
    "@angular/platform-browser-dynamic": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@fontsource/roboto": "^5.2.10",
    "@sentry/angular": "^10.69.0",
    "chart.js": "^4.5.1",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.44.0",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.9",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
